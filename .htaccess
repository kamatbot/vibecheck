<IfModule mod_mime.c>
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE model/gltf-binary application/octet-stream model/gltf+json text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
AddOutputFilterByType DEFLATE model/gltf-binary application/octet-stream

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType model/gltf-binary "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    <FilesMatch "\.(glb|png)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
